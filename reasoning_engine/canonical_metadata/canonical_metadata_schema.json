{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CMREE Canonical Metadata Schema",
  "description": "Normalized, enriched, canonical metadata document produced by CMREE for indexing and recommendation engines.",
  "type": "object",
  "required": [
    "video_id",
    "primary_category",
    "primary_ritual",
    "ritual_family",
    "primary_deity",
    "offerings",
    "language",
    "keywords",
    "confidence",
    "provenance"
  ],
  "properties": {
    "video_id": {
      "type": "string"
    },
    "primary_category": {
      "type": "string"
    },
    "primary_ritual": {
      "type": "string"
    },
    "ritual_family": {
      "type": "string"
    },
    "primary_deity": {
      "type": "string"
    },
    "temple": {
      "type": ["string", "null"]
    },
    "festival": {
      "type": ["string", "null"]
    },
    "tradition": {
      "type": "string"
    },
    "offerings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "language": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "provenance": {
      "type": "object",
      "properties": {
        "field_confidences": { "type": "object" },
        "reasoning_trace": { "type": "object" }
      }
    }
  }
}
